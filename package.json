{
  "name": "inz-puppeteer-multi-tab",
  "version": "1.0.0",
  "private": true,
  "description": "Run one Puppeteer Chrome tab per applicant email.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/runner.js",
    "test": "node --test test",
    "desktop": "electron desktop/main.js",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist": "electron-builder --mac --x64 --arm64 --win --x64 --arm64"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "puppeteer": "^24.20.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.inz.runner",
    "productName": "INZ Runner",
    "artifactName": "INZ-Runner-${version}-${os}-${arch}.${ext}",
    "asarUnpack": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "files": [
      "desktop/**/*",
      "src/**/*",
      "packaging/**/*",
      "package.json"
    ],
    "extraFiles": [
      { "from": "packaging/CAI_DAT.pdf", "to": "CAI_DAT.pdf" },
      { "from": "packaging/HUONG_DAN_SU_DUNG.pdf", "to": "HUONG_DAN_SU_DUNG.pdf" }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "11.0",
      "identity": null,
      "artifactName": "INZ-Runner-Mac.${ext}",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ]
    },
    "dmg": {
      "title": "INZ Runner",
      "artifactName": "INZ-Runner-Mac.${ext}"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "INZ Runner",
      "artifactName": "INZ-Runner-Setup.${ext}"
    },
    "portable": {
      "artifactName": "INZ-Runner-${version}-win-${arch}-portable.${ext}"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
