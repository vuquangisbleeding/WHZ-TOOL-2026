{
  "name": "inz-puppeteer-multi-tab",
  "version": "1.0.0",
  "private": true,
  "description": "Run one Puppeteer Chrome tab per applicant email.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/runner.js",
    "test": "node --test test",
    "desktop": "electron desktop/main.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "puppeteer": "^24.20.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.inz.runner",
    "productName": "INZ Runner",
    "asarUnpack": [
      "src/**/*"
    ],
    "files": [
      "desktop/**/*",
      "src/**/*",
      "2captcha-solver/**/*",
      "applicant.json",
      "emails.json",
      "proxy-list.txt",
      ".env.example",
      "package.json"
    ],
    "extraResources": [
      "2captcha-solver/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
